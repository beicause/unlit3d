<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:icon="@drawable/ic_launcher"
        android:label="Unlit3d Example"
        android:roundIcon="@drawable/ic_launcher"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:appCategory="game"
        tools:targetApi="36">
        <!-- One activity per example: `GameActivity` loads the shared library
             named by `android.app.lib_name`, and reads that entry once, when the
             activity starts. The two share everything else, the floating tab bar
             among it, through `TabbedExampleActivity`.

             Each activity runs in a process of its own because `GameActivity`
             keeps its single native handle in a process-wide static: in one
             shared process, starting the second example terminates the first
             one's native context while its event loop is still running. -->
        <activity
            android:name=".MainActivity"
            android:process=":unlit3d"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <!-- The shared library `GameActivity` loads, which is the cdylib's
                 name: `libunlit3d_examples.so` without its prefix and suffix. -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="unlit3d_examples" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".Unlit3dxActivity"
            android:process=":unlit3dx"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|keyboardHidden|screenSize|smallestScreenSize|density|keyboard|navigation|screenLayout|uiMode"
            android:theme="@style/Theme.AppCompat.NoActionBar">
            <meta-data
                android:name="android.app.lib_name"
                android:value="unlit3dx_examples" />
        </activity>
    </application>

</manifest>
